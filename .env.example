# Copy to .env. It is gitignored: nothing here reaches GitHub or an image. Deployed services read workspace secrets instead.

# Studio > API keys. Used by the agent, the evals, the judge and the workflow worker.
MISTRAL_API_KEY=

# Your connectors' names exactly as Studio shows them (Studio > Connectors), e.g. sentry_d183 and github. WORKSHOP.md 0.5-0.6.
SENTRY_CONNECTOR_NAME=
GITHUB_CONNECTOR_NAME=

# The name `make serve` runs the agent under, and the workflow opens sessions on. Make it yours so it never collides.
INVESTIGATION_AGENT_NAME=investigation-agent-<your-name>

# sample-app only: the DSN of the Sentry project that receives the six demo errors.
SENTRY_DSN=
